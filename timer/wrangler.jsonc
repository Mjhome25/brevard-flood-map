{
  // Every 15 minutes, asks GitHub to run the "Update map" workflow.
  // GitHub's own schedule is unreliable; Cloudflare's cron is not.
  "name": "brevard-map-timer",
  "account_id": "35eda903f9264997e98abda46ef035f7",
  "main": "timer.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "triggers": { "crons": ["*/15 * * * *"] }
}
